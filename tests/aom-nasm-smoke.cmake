# Run the actual patched libaom detection and assemble a Windows x64 COFF object.
# This test is cross-platform; NASM can emit win64 objects on macOS/Linux too.
cmake_minimum_required(VERSION 3.21)
foreach(required AOM_ROOT CMAKE_ASM_NASM_COMPILER OUTPUT_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}=...")
    endif()
endforeach()
set(AOM_TARGET_CPU x86_64)
set(AOM_TARGET_SYSTEM Windows)
include("${AOM_ROOT}/build/cmake/aom_optimization.cmake")
test_nasm()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(source "${OUTPUT_DIR}/nasm-smoke.asm")
set(object "${OUTPUT_DIR}/nasm-smoke.obj")
file(WRITE "${source}" "bits 64\nsection .text\nglobal bitscope_nasm_smoke\nbitscope_nasm_smoke:\n  xor eax, eax\n  ret\n")
execute_process(COMMAND "${CMAKE_ASM_NASM_COMPILER}" -Ox -f win64 "${source}" -o "${object}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "NASM -Ox / win64 assembly failed: ${result}\n${output}\n${errors}")
endif()
file(READ "${object}" machine OFFSET 0 LIMIT 2 HEX)
if(NOT machine STREQUAL "6486")
    message(FATAL_ERROR "NASM did not produce an AMD64 COFF object: ${machine}")
endif()
message(STATUS "PASS: libaom NASM detection and -Ox / win64 assembly")
